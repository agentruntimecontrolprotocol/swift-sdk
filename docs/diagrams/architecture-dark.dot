// ARCP Swift SDK architecture (dark)
digraph SwiftSdkArchitecture {
  rankdir=TB; bgcolor="transparent"; compound=true; fontname="TT Commons Pro Trial";
  splines=spline; nodesep=0.32; ranksep=0.55; pad="0.35,0.25";

  node [shape=box, style="rounded,filled", fillcolor="#334155", color="#475569",
        fontname="TT Commons Pro Trial", fontsize=11, fontcolor="#F1F5F9",
        margin="0.22,0.11", penwidth=1.0];
  edge [fontname="TT Commons Pro Trial", fontsize=9, fontcolor="#94A3B8", color="#64748B",
        penwidth=1.1, arrowsize=0.75, arrowhead=vee];

  Client [
    label=<<FONT POINT-SIZE="12"><B>ARCPClient</B></FONT><BR/><FONT POINT-SIZE="9" COLOR="#CBD5E1">invoke · ping · send</FONT>>,
    fillcolor="#3B82F6", color="#2563EB", fontcolor="white", penwidth=1.4
  ];

  subgraph cluster_runtime {
    label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD COLSPAN="3" HEIGHT="8"></TD></TR><TR><TD WIDTH="8"></TD><TD><FONT POINT-SIZE="12"><B>ARCPRuntime</B></FONT></TD><TD WIDTH="8"></TD></TR></TABLE>>;
    style="rounded,filled";
    fillcolor="#0F172A"; color="#334155";
    fontname="TT Commons Pro Trial"; fontcolor="#94A3B8";
    margin=14; labeljust=l; penwidth=1.0;

    Runtime [
      label=<<FONT POINT-SIZE="12"><B>Server</B></FONT>>,
      fillcolor="#F59E0B", color="#D97706", fontcolor="white", penwidth=1.4
    ];

    EventLog [
      label=<<FONT POINT-SIZE="10">EventLog</FONT><BR/><FONT POINT-SIZE="8" COLOR="#64748B">SQLite</FONT>>,
      shape=cylinder, fillcolor="#1E293B"
    ];
    SubMgr   [label="SubscriptionManager"];
    Artifacts [
      label=<<FONT POINT-SIZE="10">ArtifactStore</FONT><BR/><FONT POINT-SIZE="8" COLOR="#64748B">SQLite blobs</FONT>>,
      shape=cylinder, fillcolor="#1E293B"
    ];

    JobMgr   [label="JobManager"];
    Pending  [label="PendingRegistry"];
    Auth     [label="Auth (Bearer | JWT)"];
  }

  subgraph cluster_transport {
    label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD COLSPAN="3" HEIGHT="8"></TD></TR><TR><TD WIDTH="8"></TD><TD><FONT POINT-SIZE="12"><B>Transport</B></FONT></TD><TD WIDTH="8"></TD></TR></TABLE>>;
    style="rounded,filled";
    fillcolor="#1E293B"; color="#334155";
    fontname="TT Commons Pro Trial"; fontcolor="#94A3B8";
    margin=14; labeljust=l; penwidth=1.0;

    Memory [label="Memory"];
    Stdio  [label="Stdio"];
    Ws     [label="WebSocket"];

    Memory -> Stdio -> Ws [style=invis];
    { rank=same; Memory; Stdio; Ws; }
  }

  edge [color="#94A3B8", penwidth=1.2];
  Client  -> Stdio [dir=both, label="envelope (RFC §6.1)", lhead=cluster_transport];
  Stdio   -> Runtime [dir=both, label="envelope", ltail=cluster_transport];

  edge [color="#475569", penwidth=1.0];
  Runtime -> JobMgr;
  Runtime -> EventLog;
  Runtime -> SubMgr;
  Runtime -> Artifacts;
  Runtime -> Auth;
  JobMgr  -> Pending;
}
