// ARCP job state machine — matches `JobState` (Sources/ARCP/Messages/Execution.swift)
// and the wire envelopes emitted by `ARCPRuntime` / `JobManager`.
digraph ARCPJobFSM {
  graph [rankdir=LR, fontname="TT Commons Pro Trial"]
  node  [shape=box, style=rounded, fontname="TT Commons Pro Trial"]
  edge  [fontname="TT Commons Pro Trial"]

  accepted  -> queued     [label="job.accepted"]
  queued    -> running    [label="job.started"]
  running   -> running    [label="job.progress · job.heartbeat", style=dotted]
  running   -> blocked    [label="permission.request", style=dashed]
  blocked   -> running    [label="permission.grant"]
  running   -> paused     [label="job.interrupt", style=dashed]
  paused    -> running    [label="resume"]

  running   -> completed  [label="job.completed"]
  running   -> failed     [label="job.failed"]
  running   -> cancelled  [label="job.cancelled"]

  // v1.1 terminal failures on running (failed-edge variants, blue labels)
  running   -> failed     [label="LEASE_EXPIRED",    color="#D1242F", fontcolor="#1F6FEB", style=dashed]
  running   -> failed     [label="BUDGET_EXHAUSTED", color="#D1242F", fontcolor="#1F6FEB", style=dashed]
  running   -> failed     [label="HEARTBEAT_LOST",   color="#D1242F", fontcolor="#1F6FEB", style=dashed]
}
